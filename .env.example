# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Knowledge Repository - graph layer
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Knowledge Repository - vector layer
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=

# Observability
PROMETHEUS_PORT=9090

# run_workflow.py / run_doc_watch.py: persisted audit trail + human review
# queue (in-memory only if unset -- see README's "Human review queue")
AUDIT_LOG_PATH=
REVIEW_QUEUE_PATH=

# run_doc_watch.py: vendor -> template mapping enabling the full
# regenerate+validate+write pipeline (classification only if unset --
# see README's "Full pipeline: regenerating and validating templates")
TEMPLATES_CONFIG_PATH=
