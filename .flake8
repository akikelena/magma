[flake8]
max-line-length = 200
# E127/E306 conflict with this codebase's deliberately compact style
# (dense one-liner asserts/dataclasses in tests, chained continuations);
# real bugs (unused imports/names, undefined names, etc.) still fail.
extend-ignore = E127,E306
exclude = .git,__pycache__,.pytest_cache,.mypy_cache,dist,build
